<?xml version="1.0" encoding="utf-8"?>
<!-- Widget très large et bas : cadrans répartis sur toute la largeur, texte sur une ligne.
     Les tailles (cadrans, textes, marges) sont calculées par Dessin.kt selon la place disponible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond_widget"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/col1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/jauge1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Cadran de la cuve 1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/temp1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="@color/encre"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/nom1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="Cuve 1"
                android:textAllCaps="true"
                android:textColor="@color/attenue"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/col2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/jauge2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Cadran de la cuve 2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/temp2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="@color/encre"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/nom2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="Cuve 2"
                android:textAllCaps="true"
                android:textColor="@color/attenue"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/col3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/jauge3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Cadran de la cuve 3" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/temp3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:text="--"
                android:textColor="@color/encre"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/nom3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:text="Cuve 3"
                android:textAllCaps="true"
                android:textColor="@color/attenue"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
