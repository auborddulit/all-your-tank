<?xml version="1.0" encoding="utf-8"?>
<!-- Écran d'une cuve : onglets, cadran, réglage de la consigne, préréglages -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- En-tête -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Brasserie"
                android:textColor="@color/encre"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Relire tout de suite les dernières mesures -->
            <Button
                android:id="@+id/bouton_actualiser"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bouton_actualiser"
                android:contentDescription="Actualiser"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="↻"
                android:textColor="@color/sur_encre"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/bouton_reglages"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/onglets_fond"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Réglages"
                android:textAllCaps="false"
                android:textColor="@color/encre"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/etat_connexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="@color/attenue"
            android:textSize="13sp" />

        <!-- Onglets des cuves -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/onglets_fond"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/onglet1"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/onglet_actif"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/onglet2"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/onglet_inactif"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/onglet3"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/onglet_inactif"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cadran et température -->
        <fr.allyourtank.app.JaugeView
            android:id="@+id/jauge"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:contentDescription="Cadran de température" />

        <TextView
            android:id="@+id/temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="--"
            android:textColor="@color/encre"
            android:textSize="52sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/etat_cuve"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text=""
            android:textColor="@color/encre"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Réglage de la consigne -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/carte"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cible"
                    android:textColor="@color/attenue"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/cible_moins"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bouton_rond"
                        android:contentDescription="Baisser la cible"
                        android:minWidth="0dp"
                        android:text="−"
                        android:textColor="@color/encre"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/cible"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="--"
                        android:textColor="@color/encre"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/cible_plus"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bouton_rond"
                        android:contentDescription="Monter la cible"
                        android:minWidth="0dp"
                        android:text="+"
                        android:textColor="@color/encre"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/carte"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fourchette"
                    android:textColor="@color/attenue"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/fourchette_moins"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bouton_rond"
                        android:contentDescription="Réduire la fourchette"
                        android:minWidth="0dp"
                        android:text="−"
                        android:textColor="@color/encre"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/fourchette"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="--"
                        android:textColor="@color/encre"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/fourchette_plus"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bouton_rond"
                        android:contentDescription="Élargir la fourchette"
                        android:minWidth="0dp"
                        android:text="+"
                        android:textColor="@color/encre"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Préréglages -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="PRÉRÉGLAGES"
            android:textColor="@color/attenue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/prereglages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/etat_envoi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:text=""
            android:textColor="@color/attenue"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
